{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codehelix.dev/contracts/lingxi-advisor-runtime-v1.schema.json",
  "title": "Lingxi Advisor Runtime capability export",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "capability", "provider", "target", "agent_binding", "data"],
  "properties": {
    "schema": {"const": "codehelix.capability_export/v1"},
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "contract"],
      "properties": {
        "id": {"const": "lingxi.advisor.runtime"},
        "contract": {"const": "lingxi.advisor.runtime/v1"}
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plugin_id", "plugin_version", "core_distribution", "core_version"],
      "properties": {
        "plugin_id": {"const": "lingxi-advisor"},
        "plugin_version": {"type": "string", "minLength": 1},
        "core_distribution": {"const": "lingxi-advisor"},
        "core_version": {"const": "0.8.6"}
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent_system", "target_version"],
      "properties": {
        "agent_system": {"enum": ["icode", "opencode", "pi", "claude-code", "deepseek-harness"]},
        "target_version": {"type": "string", "minLength": 1}
      }
    },
    "agent_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "skills", "mcp_servers"],
      "properties": {
        "schema": {"const": "codehelix.agent_binding/v1"},
        "skills": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "root"],
            "properties": {
              "name": {"const": "lingxi-advisor"},
              "root": {"type": "string", "minLength": 1}
            }
          }
        },
        "mcp_servers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "transport", "command", "allowed_tools"],
            "properties": {
              "name": {"const": "lingxi-advisor"},
              "transport": {"const": "stdio"},
              "command": {"type": "array", "minItems": 2, "items": {"type": "string"}},
              "allowed_tools": {"const": ["lingxi.advisor.search", "lingxi.advisor.apply"]}
            }
          }
        }
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "knowledge_cache", "mode"],
      "properties": {
        "root": {"type": "string", "minLength": 1},
        "knowledge_cache": {"type": "string", "minLength": 1},
        "mode": {"const": "read_write"}
      }
    }
  }
}
