{
  "schema": "codehelix.plugin_package/v1",
  "plugin": {
    "id": "lingxi-advisor",
    "name": "Lingxi Advisor",
    "version": "0.3.13",
    "description": {
      "zh-CN": "为 Coding Agent 交付完整 Lingxi Advisor Runtime 与 Knowledge Preparation/Codify 能力。",
      "en": "Deliver the full Lingxi Advisor runtime and Knowledge Preparation/Codify capabilities."
    }
  },
  "capabilities": {
    "mining": false,
    "application": true
  },
  "compatibility": {
    "agent_system": "icode",
    "harness": "chrys",
    "gate": "capability",
    "target_version": "0.28.0",
    "required_paths": [
      "pyproject.toml",
      "src/chrys/service/profiles/agents/builtins/Code.yaml",
      "src/chrys/service/profiles/agents/loader.py"
    ]
  },
  "requires": {
    "harness_features": [
      "agent_profile",
      "skill",
      "mcp_stdio"
    ],
    "runtimes": [
      "python>=3.11",
      "uv",
      "node+npx"
    ],
    "credentials": [
      {
        "provider": "GitHub",
        "label": "GitHub Token",
        "env": "GITHUB_TOKEN",
        "required": true,
        "repeatable": true,
        "max_entries": 16,
        "prompt_before_configuration": true
      },
      {
        "provider": "LingxiAdvisor custom model",
        "label": "独立模型 API Key（Operator 生成需要；Runtime 可使用已协商的宿主 sampling）",
        "env": "LINGXI_ADVISOR_MODEL_API_KEY",
        "required": false,
        "prompt": true
      }
    ],
    "environment": [
      "PYTHON",
      "GITHUB_TOKEN_1",
      "GITHUB_TOKEN_2",
      "GITHUB_TOKEN_3",
      "GITHUB_TOKEN_4",
      "GITHUB_TOKEN_5",
      "GITHUB_TOKEN_6",
      "GITHUB_TOKEN_7",
      "GITHUB_TOKEN_8",
      "GITHUB_TOKEN_9",
      "GITHUB_TOKEN_10",
      "GITHUB_TOKEN_11",
      "GITHUB_TOKEN_12",
      "GITHUB_TOKEN_13",
      "GITHUB_TOKEN_14",
      "GITHUB_TOKEN_15",
      "LINGXI_ADVISOR_JUDGE_API_KEY",
      "LINGXI_ADVISOR_GENERATOR_API_KEY"
    ]
  },
  "dependencies": [],
  "capability_exports": [
    {
      "id": "lingxi.advisor.runtime",
      "contract": "lingxi.advisor.runtime/v1",
      "schema": "contracts/lingxi-advisor-runtime-v1.schema.json"
    }
  ],
  "components": [
    {
      "kind": "skill",
      "name": "lingxi-advisor"
    },
    {
      "kind": "skill",
      "name": "knowledge-preparation-operator"
    },
    {
      "kind": "mcp_server",
      "name": "lingxi-advisor-runtime",
      "transport": "stdio",
      "tools": [
        {
          "name": "lingxi.advisor.search",
          "read_only": false
        },
        {
          "name": "lingxi.advisor.apply",
          "read_only": true
        }
      ]
    },
    {
      "kind": "mcp_server",
      "name": "lingxi-advisor-operator",
      "transport": "stdio",
      "tools": [
        {
          "name": "lingxi.advisor.knowledge_preparation_capabilities",
          "read_only": true
        },
        {
          "name": "lingxi.advisor.prepare_historical_knowledge",
          "read_only": false
        },
        {
          "name": "lingxi.advisor.start_preparation_batch",
          "read_only": false
        },
        {
          "name": "lingxi.advisor.get_preparation_batch",
          "read_only": true
        },
        {
          "name": "lingxi.advisor.get_preparation_result",
          "read_only": true
        },
        {
          "name": "lingxi.advisor.read_prepared_knowledge",
          "read_only": true
        }
      ]
    },
    {
      "kind": "agent_profile",
      "name": "LingxiAdvisor",
      "count": 1
    }
  ],
  "surfaces": {
    "skill": {
      "required": true,
      "targets": {
        "icode": "native"
      }
    },
    "mcp_server": {
      "required": true,
      "targets": {
        "icode": "native"
      }
    },
    "agent_profile": {
      "required": true,
      "targets": {
        "icode": "native"
      }
    }
  },
  "data_pointers": [
    {
      "id": "lingxi-advisor_knowledge",
      "schema": "lingxi.advisor.knowledge_artifact/v1",
      "mode": "read_write",
      "root": "target_config",
      "path": "lingxi/advisor/data/knowl_cache",
      "include": [
        "**/*.xml",
        "**/*.manifest.json",
        "manifest.jsonl"
      ],
      "display_name": {
        "zh-CN": "任务模式知识库",
        "en": "Lingxi Advisor Knowledge"
      },
      "description": {
        "zh-CN": "已生成且通过校验的可复用任务模式知识；升级和卸载时保留。",
        "en": "Validated reusable lingxi-advisor knowledge, preserved across upgrades and removal."
      },
      "binding": {
        "configuration": "data_root",
        "path": "knowl_cache"
      }
    },
    {
      "id": "lingxi-advisor_batches",
      "schema": "lingxi.advisor.local_data/v1",
      "mode": "read_write",
      "root": "target_config",
      "path": "lingxi/advisor/data/outputs/knowledge_preparation_batches",
      "binding": {
        "configuration": "data_root",
        "path": "outputs/knowledge_preparation_batches"
      },
      "display_name": {
        "zh-CN": "知识准备批任务",
        "en": "Knowledge Preparation Batches"
      },
      "description": {
        "zh-CN": "知识准备批任务，独立于安装制品管理，卸载保留。",
        "en": "Knowledge Preparation Batches, stored independently from installed code and preserved on removal."
      },
      "include": [
        "**/*"
      ]
    },
    {
      "id": "lingxi-advisor_outputs",
      "schema": "lingxi.advisor.local_data/v1",
      "mode": "read_write",
      "root": "target_config",
      "path": "lingxi/advisor/data/outputs",
      "binding": {
        "configuration": "data_root",
        "path": "outputs"
      },
      "display_name": {
        "zh-CN": "知识准备输出与运行记录",
        "en": "Knowledge Preparation Outputs"
      },
      "description": {
        "zh-CN": "知识准备输出与运行记录，独立于安装制品管理，卸载保留。",
        "en": "Knowledge Preparation Outputs, stored independently from installed code and preserved on removal."
      },
      "include": [
        "**/*"
      ]
    },
    {
      "id": "lingxi-advisor_cache",
      "schema": "lingxi.advisor.local_data/v1",
      "mode": "read_write",
      "root": "target_config",
      "path": "lingxi/advisor/data/cache",
      "binding": {
        "configuration": "data_root",
        "path": "cache"
      },
      "display_name": {
        "zh-CN": "检索与仓库缓存",
        "en": "Retrieval and Repository Cache"
      },
      "description": {
        "zh-CN": "检索与仓库缓存，独立于安装制品管理，卸载保留。",
        "en": "Retrieval and Repository Cache, stored independently from installed code and preserved on removal."
      },
      "include": [
        "**/*"
      ]
    },
    {
      "id": "lingxi-advisor_preretrieved",
      "schema": "lingxi.advisor.preretrieved/v1",
      "mode": "read_write",
      "root": "target_config",
      "path": "lingxi/advisor/data/preretrieved_issues",
      "binding": {
        "configuration": "data_root",
        "path": "preretrieved_issues"
      },
      "display_name": {
        "zh-CN": "预检索候选知识",
        "en": "Pre-retrieved Candidates"
      },
      "description": {
        "zh-CN": "按部署权限保存的历史候选，供后续任务复用；卸载保留。",
        "en": "Historical candidates persisted when permitted for later reuse; preserved on removal."
      },
      "include": [
        "**/*"
      ]
    }
  ],
  "harness_bindings": [
    {
      "harness": "chrys",
      "profiles": [
        "LingxiAdvisor"
      ]
    }
  ],
  "configuration": {
    "inputs": [
      {
        "id": "issue_tracking_provider",
        "type": "choice",
        "required": true,
        "default": "github",
        "choices": [
          "github"
        ],
        "prompt": false
      },
      {
        "id": "gate_model_name",
        "type": "string",
        "required": false,
        "prompt": true,
        "note": "Optional model id; omit the complete model configuration to use the current Agent model"
      },
      {
        "id": "gate_model_base_url",
        "type": "string",
        "required": false,
        "prompt": true,
        "note": "OpenAI-compatible endpoint; configure together with model name and startup model key. Required for Operator generation."
      },
      {
        "id": "judge_max_output_tokens",
        "type": "string",
        "required": false,
        "default": "32768",
        "prompt": false,
        "note": "Judge output budget, including reasoning tokens where charged by the provider; integer 1024–131072."
      },
      {
        "id": "generator_max_output_tokens",
        "type": "string",
        "required": false,
        "default": "26000",
        "prompt": false,
        "note": "Generator output budget; integer 1024-131072."
      },
      {
        "id": "generator_timeout_seconds",
        "type": "string",
        "required": false,
        "default": "300",
        "prompt": false,
        "note": "Generator request timeout in seconds; integer 30-1800."
      },
      {
        "id": "mcp_request_timeout_seconds",
        "type": "string",
        "required": false,
        "default": "600",
        "prompt": false,
        "note": "Installation-time host MCP request timeout in seconds; integer 30-1800. Re-run managed install/update to change it."
      },
      {
        "id": "allow_preretrieved_updates",
        "type": "choice",
        "required": false,
        "default": "true",
        "choices": [
          "true",
          "false"
        ],
        "prompt": false,
        "note": "Persistent pre-retrieved updates are enabled by default"
      },
      {
        "id": "data_root",
        "type": "path",
        "required": false,
        "prompt": false,
        "note": "Persistent LingxiAdvisor data directory; default: target config/lingxi/advisor/data. Preserved on removal."
      },
      {
        "id": "batch_input_path",
        "type": "path",
        "required": false,
        "prompt": false,
        "note": "Server-owned public task JSONL input for Operator batches."
      },
      {
        "id": "allow_live_search",
        "type": "choice",
        "required": false,
        "prompt": false,
        "default": "true",
        "choices": [
          "true",
          "false"
        ]
      },
      {
        "id": "allow_refresh",
        "type": "choice",
        "required": false,
        "prompt": false,
        "default": "false",
        "choices": [
          "true",
          "false"
        ]
      },
      {
        "id": "allow_clone",
        "type": "choice",
        "required": false,
        "prompt": false,
        "default": "false",
        "choices": [
          "true",
          "false"
        ]
      },
      {
        "id": "allow_fetch",
        "type": "choice",
        "required": false,
        "prompt": false,
        "default": "false",
        "choices": [
          "true",
          "false"
        ]
      }
    ]
  },
  "extensions": {},
  "installer": {
    "protocol": "codehelix.plugin_installer/v1",
    "command": [
      "npx",
      "--package",
      ".",
      "codehelix-lingxi-advisor",
      "protocol"
    ],
    "operations": [
      "check",
      "plan",
      "install",
      "verify"
    ],
    "timeout_seconds": {
      "check": 60,
      "plan": 60,
      "install": 1200,
      "verify": 600
    },
    "entrypoint": "installer/installer.py"
  },
  "installation": {
    "target_inputs": [
      "coding_agent",
      "config_root"
    ],
    "payload": [
      {
        "source": "runtime",
        "target": "managed PackageStore and Python Runtime"
      },
      {
        "source": "assets/skills",
        "target": "managed Skill activations"
      },
      {
        "source": "launcher.py",
        "target": "managed PackageStore launcher"
      }
    ],
    "patches": [],
    "registrations": [
      {
        "kind": "agent_profile",
        "name": "LingxiAdvisor",
        "owner": "package"
      },
      {
        "kind": "mcp_server",
        "name": "lingxi-advisor",
        "owner": "package"
      },
      {
        "kind": "mcp_server",
        "name": "lingxi-advisor-operator",
        "owner": "package"
      },
      {
        "kind": "capability_export",
        "name": "lingxi.advisor.runtime/v1",
        "owner": "package"
      }
    ]
  },
  "verification": {
    "level": "real",
    "date": "2026-09-29",
    "versions": [
      "0.28.0"
    ],
    "evidence": "Chrys 0.28.0 at 5344293: isolated installation and real host loading/protocol checks. Scope and outstanding online business acceptance: ../../../docs/acceptance/lingxi-advisor-swe-pro/2026-10-04/issues/README.md."
  },
  "integrity": null,
  "managed_install": {
    "schema": "codehelix.managed_install/v1",
    "runtimes": [
      {
        "id": "lingxi-advisor",
        "kind": "python",
        "python": "3.12",
        "source": "runtime/lingxi-advisor-extension-0.8.6/runtime/lingxi_advisor-0.8.6-py3-none-any.whl",
        "command": "lingxi-advisor-mcp",
        "requirements": "runtime-requirements.lock"
      }
    ],
    "skills": [
      {
        "id": "lingxi-advisor",
        "source": "assets/skills/lingxi-advisor",
        "destination": "lingxi/advisor/skills/lingxi-advisor"
      },
      {
        "id": "knowledge-preparation-operator",
        "source": "assets/skills/knowledge-preparation-operator",
        "destination": "lingxi/advisor/skills/knowledge-preparation-operator"
      }
    ],
    "target_paths": [
      {
        "root": "config",
        "path": "lingxi/advisor/exports/lingxi.advisor.runtime-v1.json",
        "kind": "capability_export"
      },
      {
        "root": "config",
        "path": "agents/LingxiAdvisor.yaml",
        "kind": "profile"
      }
    ],
    "legacy_ownership": {
      "path": "lingxi/advisor/runtime/codehelix-install.json",
      "files_key": "managed_files",
      "on_remove": "deactivate"
    }
  }
}
